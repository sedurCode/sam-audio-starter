      "label": "SHARC+: release compound core 1 (external OpenOCD)",
      "type": "process",
      "command": "${config:sharc-plus.toolchain}/target/release/sharc-debug",
      "args": [
        "session-release",
        "--state",
        "${workspaceFolder}/out/debug-session/compound",
        "--participant",
        "core1",
        "--keep-server"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${config:sharc-plus.toolchain}"
      }
    },
    {
      "label": "SHARC+: release compound core 2 (external OpenOCD)",
      "type": "process",
      "command": "${config:sharc-plus.toolchain}/target/release/sharc-debug",
      "args": [
        "session-release",
        "--state",
        "${workspaceFolder}/out/debug-session/compound",
        "--participant",
        "core2",
        "--keep-server"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${config:sharc-plus.toolchain}"
